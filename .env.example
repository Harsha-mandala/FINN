# FINN — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Your Google AI Studio API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM Model Routing ─────────────────────────────────────────────────────────
# Route tasks to different models to spread your daily request quota.
# All defaults target the highest-RPD free-tier models.
# Override if your key tier supports different models.

# Used for: Stage-2 research synthesis, grounded management bios
# Free-tier RPD: ~20 requests/day
GEMINI_MODEL=gemini-2.5-flash

# Used for: announcement classification, per-document extraction, chat
# Free-tier RPD: ~500 requests/day
GEMINI_CHEAP_MODEL=gemini-3.5-flash-lite

# Comma-separated fallback models tried in order on 429/quota
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash-lite

# Optional: override daily limit estimates per model (used in /health/llm headroom calc)
# Example:
# GEMINI_DAILY_LIMIT_GEMINI_3_5_FLASH_LITE=500
# GEMINI_DAILY_LIMIT_GEMINI_2_5_FLASH=20

# ── CORS / Deployment ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
